# Copy to .env (gitignored) for local runs of scripts/backfill.py and
# scripts/daily_sync.py. In CI these are supplied as GitHub Actions secrets
# instead — see .github/workflows/daily-sync.yml and README.md.

# Postgres connection string (Supabase free tier or similar). Repo is
# public, so health data lives here, never in git. Use the "session
# pooler" URI from Supabase (port 6543) for serverless/CI-friendly conns,
# or the direct connection (port 5432) for local backfill.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Only used by scripts/daily_sync.py locally / in CI. Populated by
# scripts/bootstrap_auth.py — see README.md "Phase 0".
GARMIN_TOKENS=
